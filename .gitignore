# Lerian CLI - Git Ignore Rules

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
*.coverprofile
coverage.html
*-coverage.html
config-coverage.out
profile.cov

# Go workspace file
go.work
go.work.sum

# Build directories
bin/
build/
dist/
*.snap

# Dependency directories
vendor/

# Environment files
.env
.env.local
.env.*.local
*.local.yaml
.secrets

# IDE - VSCode
.vscode/
*.code-workspace

# IDE - JetBrains (GoLand, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# IDE - Vim
*.swp
*.swo
*~
.*.sw?

# IDE - Emacs
*~
\#*\#
.\#*

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.log
*.pid
*.seed
*.pid.lock

# Backup files
*.bak
*.backup
backups/

# Debug files
debug
debug.test
__debug_bin

# GoReleaser artifacts
.goreleaser.yml.bak

# Air (hot reload) temporary files
tmp/

# Configuration backups
*.yaml.bak
*.yml.bak

# Local testing
.test/
testdata/local/

# Release archives
*.tar.gz
*.zip
*.tgz

# Documentation builds
site/
_site/

# Phase summary and planning files
PHASE*_SUMMARY.md
EXTRACTION_PLAN.md
README.original.md

# MacOS
.AppleDouble
.LSOverride

# Linux
.directory
.Trash-*

# Windows
$RECYCLE.BIN/

# Certificate files (if any)
*.pem
*.key
*.crt
*.p12
*.pfx

# Local configuration overrides
config.local.yaml
.lerian/
